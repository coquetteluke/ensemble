{
  "default": {"text": "Mock reply from the default rule.", "title": "Mock session"},
  "rules": [
    {"match": ["<subagent"], "text": "The helper reported back."},
    {"match": ["child task marker"], "text": "Child finished the task."},
    {"match": ["board relay marker"], "text": "Got the board message."},
    {"match": ["hello"], "text": "Hello from the mock model. Nice to meet you.", "chunks": 6},
    {"match": ["think first"], "reasoning": "Let me think about this carefully.", "text": "Thought about it."},
    {"match": ["run the echo"], "tool": {"name": "shell", "arguments": {"command": "echo ensemble-ok"}}, "then": "The command printed ensemble-ok."},
    {"match": ["auto safe"], "tool": {"name": "shell", "arguments": {"command": "git status --short"}}, "then": "Git status ran."},
    {"match": ["auto risky"], "tool": {"name": "shell", "arguments": {"command": "rm -r -f nothing-here-ensemble"}}, "then": "Asked before deleting."},
    {"match": ["start a helper"], "tool": {"name": "subagent", "arguments": {"agent": "general", "description": "Mock helper task", "prompt": "child task marker: say done"}}, "then": "I started a helper."},
    {"match": ["write a file"], "tool": {"name": "write", "arguments": {"path": "hello.txt", "content": "hi from mock\n"}}, "then": "Wrote hello.txt."},
    {"match": ["edit the file"], "reasoning": "I should change the greeting.", "tool": {"name": "edit", "arguments": {"path": "hello.txt", "oldString": "hi from mock", "newString": "hello from mock"}}, "then": "Edited hello.txt."},
    {"match": ["fail a tool"], "tool": {"name": "read", "arguments": {"path": "does-not-exist.txt"}}, "then": "The read failed."},
    {"match": ["go slow"], "text": "This reply streams very slowly so it can be interrupted midway through the sentence.", "chunks": 40, "delay": 0.5}
  ]
}
